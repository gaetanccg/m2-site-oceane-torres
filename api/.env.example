APP_NAME="Oceane Torres Photographie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# DATABASE - SUPABASE POSTGRESQL
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password

# ===========================================
# SESSION & CACHE
# ===========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# ===========================================
# MINIO STORAGE (S3 Compatible)
# ===========================================
FILESYSTEM_DISK=minio
MINIO_ENDPOINT=https://your-minio-endpoint.com
# MINIO_PUBLIC_URL : optionnel. À renseigner uniquement si MINIO_ENDPOINT diffère
# de l'URL accessible depuis le navigateur (cas prod NAS où Laravel pointe vers
# host.docker.internal:9000 mais les signed URLs doivent rester publiques). Voir audit P3.2.
# MINIO_PUBLIC_URL=https://your-public-minio-url.com
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=galleries
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

# ===========================================
# EMAILS
# ===========================================
# Local: Mailpit (port 1025) | Production: Brevo SMTP (port 587)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_ADMIN_EMAIL=admin@example.com

# ===========================================
# CORS & SANCTUM
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# ===========================================
# SUMUP (PAIEMENTS)
# ===========================================
SUMUP_API_KEY=your_sumup_secret_key
SUMUP_PUBLIC_KEY=your_sumup_public_key
SUMUP_MERCHANT_CODE=your_merchant_code
SUMUP_ENV=sandbox
