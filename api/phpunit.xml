<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- La generation reelle de PDF (DomPDF) dans les tests de facturation depasse
             les 128 Mo par defaut du CLI. La production est a 2048 Mo. -->
        <ini name="memory_limit" value="512M"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Base de test : Postgres dédié (service docker `postgres-test`, profil `test`).
            Le code utilise du SQL Postgres non portable (pg_advisory_xact_lock,
            FILTER (WHERE), scopes whereRaw booléens) → SQLite est exclu.

            Lancer les tests DEPUIS L'HÔTE : `make test`. Dans le conteneur `laravel`,
            127.0.0.1:55432 ne désigne pas postgres-test.

            ⚠️ Ces valeurs ne protègent de rien. PHPUnit n'écrit que getenv() et $_ENV,
            alors que env() de Laravel interroge $_SERVER en premier : une variable
            d'environnement réelle l'emporte, y compris avec force="true". Un conteneur
            démarré avec des identifiants distants imposerait donc sa base, et
            RefreshDatabase (migrate:fresh) en supprimerait toutes les tables.
            La protection réelle est Tests\RefusesNonLocalDatabase, qui vérifie la
            configuration résolue avant toute migration.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="55432"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>

        <!-- Sans cela la suite de tests remonte a Sentry : les exceptions volontaires
             des tests atterrissaient dans le projet reel. -->
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="SENTRY_DSN" value=""/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FILESYSTEM_DISK" value="minio"/>

        <!--
            SumUp : on reste en SANDBOX pour les tests de paiement (comportement
            identique au dev local). ⚠️ En sandbox + APP_ENV testing,
            OrderService::verifyAndUpdateOrder() auto-complète la commande sans
            appeler l'API SumUp — c'est intentionnel et testé comme tel.
            Le webhook, lui, appelle toujours getCheckout() : il faut Http::fake().
        -->
        <env name="SUMUP_ENV" value="sandbox"/>
        <env name="SUMUP_API_KEY" value="test_sumup_key"/>
        <env name="SUMUP_MERCHANT_CODE" value="TEST_MERCHANT"/>
        <env name="SUMUP_PUBLIC_KEY" value="test_public_key"/>
        <env name="APP_URL" value="http://localhost"/>

        <!-- Services externes neutralisés -->
        <env name="BREVO_API_KEY" value="test_brevo_key"/>

        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
