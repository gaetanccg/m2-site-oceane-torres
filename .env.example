# Docker Compose Environment Variables
# Copy this to .env and fill in the values

# Application
APP_ENV=local
APP_DEBUG=true

# Database (Supabase)
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Docker utilise le Session Pooler (IPv4 compatible)
DB_HOST_DOCKER=aws-1-eu-west-1.pooler.supabase.com
DB_USERNAME_DOCKER=postgres.your-project-ref
