# ===========================================
# ENVIRONNEMENT PREPROD - NAS UGREEN
# ===========================================
# Preprod iso-prod : mêmes services, mais base dédiée, SumUp sandbox,
# Brevo dédié et bucket MinIO séparé. Tourne EN PARALLÈLE de la prod
# sur le même NAS (containers -preprod, port 8081, réseau dédié).
#
# 1. Copier ce fichier : cp deploy/.env.preprod.example deploy/.env.preprod
# 2. Remplir les valeurs marquées <SECRET>
# 3. Ne JAMAIS commiter .env.preprod
# ===========================================

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="Oceane Torres Photographie (Preprod)"
# APP_ENV=production pour un comportement iso-prod (config cache, debug off).
# Conséquence voulue : le raccourci sandbox auto-complete d'OrderService NE
# s'active PAS ; les paiements passent par le vrai flux SumUp sandbox.
APP_ENV=production
APP_KEY=<SECRET: php artisan key:generate>
APP_DEBUG=false
APP_URL=https://preprod-api.oceanetorresphotographie.fr
FRONTEND_URL=https://preprod.oceanetorresphotographie.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily (et non single) : avec LOG_LEVEL=debug et sans rotation,
# storage/logs/laravel.log grossit très vite jusqu'à saturer le NAS.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Preprod plus verbeuse que la prod pour faciliter le debug.
LOG_LEVEL=debug

# ===========================================
# DATABASE - SUPABASE POSTGRESQL (BASE DÉDIÉE PREPROD)
# ===========================================
# Utiliser un PROJET Supabase distinct de la prod (ou a minima une base
# distincte). Ne jamais pointer sur la base de production.
DB_CONNECTION=pgsql
DB_HOST=<SECRET: pooler URL Supabase PREPROD>
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=<SECRET: username Supabase PREPROD>
DB_PASSWORD=<SECRET: password Supabase PREPROD>

# ===========================================
# SESSION & CACHE
# ===========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Front (preprod.…) et API (preprod-api.…) partagent le parent
# .oceanetorresphotographie.fr, comme en prod. Isolation vs prod via SESSION_COOKIE.
SESSION_DOMAIN=.oceanetorresphotographie.fr
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
# Nom de cookie distinct de la prod : évite toute collision de session.
SESSION_COOKIE=oceane_preprod_session

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=file

# ===========================================
# MINIO STORAGE (NAS) - BUCKET DÉDIÉ PREPROD
# ===========================================
# Même serveur MinIO que la prod, mais BUCKET séparé (galleries-preprod)
# pour ne jamais toucher aux fichiers de production. Créer le bucket avant
# le premier déploiement (voir docs/deploiement-preprod.md).
# MINIO_ENDPOINT = URL PUBLIQUE (pas host.docker.internal) : les URLs pré-signées
# doivent être signées pour le host contacté par le navigateur, sinon MinIO renvoie
# SignatureDoesNotMatch (le host fait partie de la signature SigV4).
FILESYSTEM_DISK=minio
MINIO_ENDPOINT=https://s3.oceanetorresphotographie.fr
MINIO_PUBLIC_URL=https://s3.oceanetorresphotographie.fr
MINIO_ACCESS_KEY=<SECRET: MinIO access key>
MINIO_SECRET_KEY=<SECRET: MinIO secret key>
MINIO_BUCKET=galleries-preprod
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

# ===========================================
# EMAILS & SMS - BREVO (COMPTE DÉDIÉ PREPROD)
# ===========================================
# La preprod a son PROPRE compte Brevo, pour ne pas polluer les statistiques
# d'envoi ni consommer les crédits SMS de la prod.
#
# 4 champs sont propres au compte : les basculer TOUS LES QUATRE ensemble.
# En oublier un laisse la preprod émettre depuis le compte de prod, ou casse
# l'authentification SMTP (login d'un compte + clé d'un autre => 535).
#
#   MAIL_USERNAME     Brevo > SMTP & API > onglet SMTP    > "Login"  (<id>@smtp-brevo.com)
#   MAIL_PASSWORD     Brevo > SMTP & API > onglet SMTP    > clé SMTP (xsmtpsib-...)
#   BREVO_API_KEY     Brevo > SMTP & API > onglet API keys           (xkeysib-...)
#   MAIL_FROM_ADDRESS Brevo > Senders    > une adresse VALIDÉE de CE compte
#
# MAIL_USERNAME et MAIL_PASSWORD forment une paire indissociable.
# BREVO_API_KEY est indépendante de la clé SMTP : elle ne sert QU'aux SMS
# (App\Services\BrevoSmsService, envois de sessions scolaires). Tant qu'elle
# pointe sur l'autre compte, les SMS de preprod débitent ses crédits.
#
# MAIL_HOST / MAIL_PORT / MAIL_MAILER sont communs à tous les comptes Brevo.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<SECRET: Brevo SMTP login PREPROD, forme NNNNNN@smtp-brevo.com>
MAIL_PASSWORD=<SECRET: Brevo SMTP key PREPROD (xsmtpsib-...)>
# Ignoré depuis Laravel 11 : le transport SMTP ne lit que MAIL_SCHEME, avec
# repli sur le port (465 => smtps, sinon smtp). Sur 587 le STARTTLS se
# négocie seul. Conservé pour mémoire, changer sa valeur n'a aucun effet.
MAIL_ENCRYPTION=tls
# DOIT être un expéditeur validé DU COMPTE PREPROD (Brevo > Senders), sinon
# tout envoi est rejeté "sender is not valid" et la panne est silencieuse :
# les listeners de contact/réservation avalent l'exception et la loguent.
# Ne PAS y remettre le domaine de la prod : il n'est authentifié que sur le
# compte de prod. C'est MAIL_FROM_NAME (APP_NAME contient « Preprod ») qui
# distingue l'origine, pas l'adresse.
MAIL_FROM_ADDRESS=<SECRET: expéditeur validé du compte Brevo PREPROD>
MAIL_FROM_NAME="${APP_NAME}"
# Nom d'expéditeur SMS alphanumérique : se déclare PAR COMPTE chez Brevo.
# À redéclarer dans le compte preprod avant de tester les SMS.
BREVO_SMS_SENDER="OceanePhoto"
BREVO_API_KEY=<SECRET: Brevo API key PREPROD (xkeysib-...)>

# Destinataires — sans lien avec le compte Brevo. Les pointer sur une boîte de
# test : sinon les mails de preprod atterrissent chez la photographe, mêlés à
# ceux de la prod et indiscernables.
MAIL_ADMIN_EMAIL=<SECRET: email admin de test PREPROD>

# ===========================================
# SUMUP (PAIEMENTS) - SANDBOX
# ===========================================
# Clés sandbox uniquement (préfixe sk_test_). SUMUP_ENV=sandbox.
SUMUP_API_KEY=<SECRET: SumUp SANDBOX API key (sk_test_...)>
SUMUP_PUBLIC_KEY=<SECRET: SumUp SANDBOX public key>
SUMUP_MERCHANT_CODE=<SECRET: SumUp SANDBOX merchant code>
SUMUP_ENV=sandbox

# ===========================================
# CORS & SANCTUM
# ===========================================
CORS_ALLOWED_ORIGINS=https://preprod.oceanetorresphotographie.fr
SANCTUM_STATEFUL_DOMAINS=preprod.oceanetorresphotographie.fr,preprod-api.oceanetorresphotographie.fr

# ===========================================
# SUPERVISION (cf. docs/supervision.md)
# ===========================================
APP_VERSION=2.3.0-preprod

# Vide = /api/health/details fermé. Générer : php -r "echo bin2hex(random_bytes(32));"
HEALTH_CHECK_TOKEN=

SUPERVISION_ALERTS_ENABLED=true
SUPERVISION_ALERT_EMAIL=
SUPERVISION_ALERT_COOLDOWN_MINUTES=60

SUPERVISION_DATABASE_SLOW_MS=1000
SUPERVISION_QUEUE_DEPTH=100
SUPERVISION_QUEUE_OLDEST_PENDING_MINUTES=15
SUPERVISION_QUEUE_WORKER_STALE_MINUTES=10
SUPERVISION_SCHEDULER_STALE_MINUTES=120

# Vide = listing d'un préfixe inexistant au lieu d'un HEAD sur objet témoin.
SUPERVISION_STORAGE_WITNESS=

# URLs de ping healthchecks.io. Vides = aucun ping émis.
HEALTHCHECKS_RGPD_URL=
HEALTHCHECKS_RECONCILE_URL=

# Vide = SDK Sentry inerte, aucun appel réseau.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# APP_ENV vaut `production` en preprod : sans cette variable, les erreurs
# preprod seraient indistinguables des erreurs de production dans Sentry.
SENTRY_ENVIRONMENT=preprod
