# ===========================================
# ENVIRONNEMENT PRODUCTION - NAS UGREEN
# ===========================================
# 1. Copier ce fichier : cp .env.prod.example .env.prod
# 2. Remplir les valeurs marquées <SECRET>
# 3. Ne JAMAIS commiter .env.prod
# ===========================================

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="Oceane Torres Photographie"
APP_ENV=production
APP_KEY=<SECRET: php artisan key:generate>
APP_DEBUG=false
APP_URL=https://api.oceanetorresphotographie.fr
FRONTEND_URL=https://oceanetorresphotographie.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily (et non single) : sans rotation, laravel.log grossit sans limite.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# DATABASE - SUPABASE POSTGRESQL
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=<SECRET: pooler URL Supabase>
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=<SECRET: username Supabase>
DB_PASSWORD=<SECRET: password Supabase>

# ===========================================
# SESSION & CACHE
# ===========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.oceanetorresphotographie.fr
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# database (et non sync) : c'est cette file que consomme le conteneur api-queue.
QUEUE_CONNECTION=database
CACHE_STORE=file

# ===========================================
# MINIO STORAGE (NAS)
# ===========================================
# Audit P3.2 — Dual endpoint pour bypass le tunnel Cloudflare en interne :
#   MINIO_ENDPOINT     : utilisé par Laravel pour les API calls (put/get/list).
#                        Sur le NAS, pointe vers host.docker.internal:9000 (port MinIO publié sur le host).
#                        Le tunnel Cloudflare est complètement contourné côté serveur (-100/-300 ms par PUT).
#   MINIO_PUBLIC_URL   : utilisé pour réécrire les signed URLs renvoyées au navigateur (download photo,
#                        vidéos publiques). DOIT être l'URL publique accessible depuis l'extérieur.
FILESYSTEM_DISK=minio
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_PUBLIC_URL=https://s3.oceanetorresphotographie.fr
MINIO_ACCESS_KEY=<SECRET: MinIO access key>
MINIO_SECRET_KEY=<SECRET: MinIO secret key>
MINIO_BUCKET=galleries
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

# ===========================================
# EMAILS - BREVO SMTP
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<SECRET: Brevo SMTP username>
MAIL_PASSWORD=<SECRET: Brevo SMTP password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@oceanetorresphotographie.fr"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_ADMIN_EMAIL=oceanetorresphotographie@gmail.com

# ===========================================
# SUMUP (PAIEMENTS)
# ===========================================
SUMUP_API_KEY=<SECRET: SumUp API key>
SUMUP_PUBLIC_KEY=<SECRET: SumUp public key>
SUMUP_MERCHANT_CODE=<SECRET: SumUp merchant code>
SUMUP_ENV=live

# ===========================================
# CORS & SANCTUM
# ===========================================
CORS_ALLOWED_ORIGINS=https://oceanetorresphotographie.fr
SANCTUM_STATEFUL_DOMAINS=oceanetorresphotographie.fr,api.oceanetorresphotographie.fr

# ===========================================
# SUPERVISION (cf. docs/supervision.md)
# ===========================================
# À aligner sur le tag git à chaque mise en production.
APP_VERSION=2.3.0

# Vide = /api/health/details fermé. Générer : php -r "echo bin2hex(random_bytes(32));"
HEALTH_CHECK_TOKEN=<SECRET: jeton de supervision>

SUPERVISION_ALERTS_ENABLED=true
SUPERVISION_ALERT_EMAIL=
SUPERVISION_ALERT_COOLDOWN_MINUTES=60

SUPERVISION_DATABASE_SLOW_MS=1000
SUPERVISION_QUEUE_DEPTH=100
SUPERVISION_QUEUE_OLDEST_PENDING_MINUTES=15
SUPERVISION_QUEUE_WORKER_STALE_MINUTES=10
SUPERVISION_SCHEDULER_STALE_MINUTES=120

# Vide = listing d'un préfixe inexistant au lieu d'un HEAD sur objet témoin.
SUPERVISION_STORAGE_WITNESS=

# URLs de ping healthchecks.io. Vides = aucun ping émis.
HEALTHCHECKS_RGPD_URL=
HEALTHCHECKS_RECONCILE_URL=

# Vide = SDK Sentry inerte, aucun appel réseau.
SENTRY_DSN=<SECRET: DSN Sentry projet API>
SENTRY_TRACES_SAMPLE_RATE=0
