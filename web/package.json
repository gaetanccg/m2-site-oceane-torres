{
  "name": "oceane-torres-photographie",
  "private": true,
  "version": "6.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:prerender": "vue-tsc -b && vite build && node scripts/prerender.js",
    "prerender": "node scripts/prerender.js",
    "generate-thumbs": "node scripts/generate-thumbs.js",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/vue": "^10.69.0",
    "pinia": "^3.0.4",
    "vue": "^3.4.38",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "puppeteer": "^25.8.0",
    "serve": "^14.2.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.53.1",
    "vite": "6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.4"
  }
}
