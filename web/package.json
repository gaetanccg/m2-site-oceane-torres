{
    "name": "oceane-torres-photographie",
    "private": true,
    "version": "2.2.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "build:prerender": "vue-tsc -b && vite build && node scripts/prerender.js",
        "prerender": "node scripts/prerender.js",
        "generate-thumbs": "node scripts/generate-thumbs.js",
        "preview": "vite preview",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@sentry/vue": "^10.69.0",
        "pinia": "^3.0.4",
        "vue": "^3.4.38",
        "vue-router": "^4.6.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^25.0.3",
        "@vitejs/plugin-vue": "^5.1.3",
        "autoprefixer": "^10.4.22",
        "eslint": "^9.39.2",
        "eslint-plugin-vue": "^10.7.0",
        "postcss": "^8.5.6",
        "puppeteer": "^24.35.0",
        "serve": "^14.2.5",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.4.18",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.53.1",
        "vite": "6.4.1",
        "vue-tsc": "^2.1.4"
    }
